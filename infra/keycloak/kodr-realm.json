{
  "realm": "kodr",
  "displayName": "Kodr",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "accessTokenLifespan": 600,
  "roles": {
    "realm": [
      {
        "name": "student"
      },
      {
        "name": "teacher"
      },
      {
        "name": "grader"
      },
      {
        "name": "admin"
      },
      {
        "name": "offline_access"
      },
      {
        "name": "uma_authorization"
      },
      {
        "name": "default-roles-kodr",
        "composite": true,
        "composites": {
          "realm": [
            "student",
            "offline_access",
            "uma_authorization"
          ]
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-kodr",
    "description": "Роль нового пользователя",
    "composite": true
  },
  "clients": [
    {
      "clientId": "kodr-web",
      "enabled": true,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "roles",
        "web-origins"
      ],
      "protocolMappers": [
        {
          "name": "kodr-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "access.token.claim": "true",
            "included.custom.audience": "kodr-api",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ],
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "kodr-cli",
      "enabled": true,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "roles",
        "web-origins"
      ],
      "protocolMappers": [
        {
          "name": "kodr-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "access.token.claim": "true",
            "included.custom.audience": "kodr-api",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ],
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true
    },
    {
      "clientId": "kodr-grader",
      "enabled": true,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "roles",
        "web-origins"
      ],
      "protocolMappers": [
        {
          "name": "kodr-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "access.token.claim": "true",
            "included.custom.audience": "kodr-api",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ],
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "${GRADER_CLIENT_SECRET}"
    }
  ],
  "users": [
    {
      "username": "student",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Kodr",
      "lastName": "Student",
      "email": "student@example.test",
      "credentials": [
        {
          "type": "password",
          "value": "kodr-dev-student",
          "temporary": false
        }
      ],
      "realmRoles": [
        "student"
      ]
    },
    {
      "username": "teacher",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Kodr",
      "lastName": "Teacher",
      "email": "teacher@example.test",
      "credentials": [
        {
          "type": "password",
          "value": "kodr-dev-teacher",
          "temporary": false
        }
      ],
      "realmRoles": [
        "teacher"
      ]
    },
    {
      "username": "service-account-kodr-grader",
      "enabled": true,
      "serviceAccountClientId": "kodr-grader",
      "realmRoles": [
        "grader"
      ]
    }
  ]
}
